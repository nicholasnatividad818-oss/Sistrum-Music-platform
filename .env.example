# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Feed.fm Feed Radio SDK credentials.
# Use development credentials until Feed.fm approves the production implementation.
VITE_FEEDFM_TOKEN=""
VITE_FEEDFM_SECRET=""

# Feed Clips bearer token for licensed short-form music.
# Signed media URLs and rights/reporting rules are enforced by Feed Clips.
VITE_FEED_CLIPS_TOKEN=""

# Spotify uses Authorization Code with PKCE: NEVER add a client secret to VITE_*.
# The public NRN Client ID is the default; override for another developer app.
VITE_SPOTIFY_CLIENT_ID="ab765959ac7748f992e5394dc6626ef4"
# Exact URI registered in Spotify Dashboard. Blank uses the current origin.
# Local: npm run dev:spotify, then open http://127.0.0.1:8000
# Production: register the HTTPS site origin in Spotify before connecting.
VITE_SPOTIFY_REDIRECT_URI=""
