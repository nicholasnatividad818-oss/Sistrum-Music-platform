{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|privacy.html|terms.html|sw.js|manifest.webmanifest|icons/).*)", "destination": "/index.html" }
  ]
}
